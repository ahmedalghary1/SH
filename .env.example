# SECURITY WARNING: keep the secret key used in production secret!
# Generate a strong key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-local-development-key-change-me

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False

# Allowed hosts for the application (comma-separated)
# Production example: example.com,www.example.com
ALLOWED_HOSTS=127.0.0.1,localhost,sh.elwsamstore.com

# CSRF trusted origins for secure requests (comma-separated, include https://)
# Production example: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# Database Configuration

ENGINE="django.db.backends.postgresql"
NAME="elwsamst_sh"
USER= "elwsamst_system"
PASSWORD= "ahmed01552810113"
HOST= "localhost"
PORT= "5432"

# Static and Media Files
# cPanel production example:
# PUBLIC_ROOT=/home/elwsamst/public_html
# STATIC_ROOT=/home/elwsamst/public_html/static
# MEDIA_URL=/sh_media/
# MEDIA_ROOT=/home/elwsamst/public_html/sh_media
USE_WHITENOISE=True
WHITENOISE_USE_FINDERS=True
SERVE_STATIC_WITH_DJANGO=True
STATIC_URL=/static/
PUBLIC_ROOT=
STATIC_ROOT=
MEDIA_URL=
MEDIA_ROOT=
SERVE_MEDIA_WITH_DJANGO=True
# Optional comma-separated extra directories to search for existing uploaded files.
MEDIA_FALLBACK_ROOTS=

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs

# Security Settings (Production)
# Set to True in production when using HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_AGE=2592000
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY

# PDF Arabic rendering
# Leave empty to use static/fonts/NotoNaskhArabic-Regular.ttf.
PDF_ARABIC_FONT_PATH=

# ---------------------------------------------------------------
# Backup Configuration (Phase 3)
# ---------------------------------------------------------------

# Encryption key for database backups (Fernet base64-encoded 32-byte key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to store backups unencrypted (not recommended in production).
BACKUP_ENCRYPTION_KEY=

# Off-site / S3-compatible backup storage (optional).
# Leave AWS_S3_BUCKET_NAME empty to disable remote upload entirely.
# Compatible with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Custom endpoint for non-AWS S3-compatible storage (e.g. https://account.r2.cloudflarestorage.com)
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION=us-east-1
# Prefix/folder inside the bucket (trailing slash included)
AWS_S3_PREFIX=backups/

# ---------------------------------------------------------------
# Error Monitoring — Sentry (optional)
# ---------------------------------------------------------------

# Set SENTRY_DSN to enable Sentry error monitoring.
# Leave empty to disable (application will not fail if sentry_sdk is missing).
# Install with: pip install sentry-sdk
SENTRY_DSN=
# Percentage of transactions to sample for performance tracing (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Application version tag sent to Sentry (e.g. git commit hash or release tag)
APP_VERSION=unknown
