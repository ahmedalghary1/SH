{
  "name": "sh-erp-desktop",
  "version": "0.1.0",
  "description": "Offline-first Electron desktop client for SH Django ERP.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "lint": "echo \"Add lint later\"",
    "test": "echo \"Manual scenarios are documented in docs/testing-scenarios.md\""
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.elwsamstore.sh.desktop",
    "productName": "SH ERP Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "database/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
